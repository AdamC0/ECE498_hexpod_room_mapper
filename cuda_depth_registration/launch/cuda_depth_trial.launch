<launch>
  <!-- Compatibility wrapper retained for the original side-by-side command. -->
  <arg name="input_image" default="/camera/depth/image_raw" />
  <arg name="depth_camera_info" default="/camera/depth/camera_info" />
  <arg name="rgb_camera_info" default="/camera/rgb/camera_info" />
  <arg name="output_image" default="/camera/depth_registered_cuda/image_raw" />
  <arg name="output_camera_info" default="/camera/depth_registered_cuda/camera_info" />
  <arg name="calibration_service" default="/camera/get_camera_params" />

  <include file="$(find cuda_depth_registration)/launch/cuda_depth_registration.launch">
    <arg name="input_image" value="$(arg input_image)" />
    <arg name="depth_camera_info" value="$(arg depth_camera_info)" />
    <arg name="rgb_camera_info" value="$(arg rgb_camera_info)" />
    <arg name="output_image" value="$(arg output_image)" />
    <arg name="output_camera_info" value="$(arg output_camera_info)" />
    <arg name="calibration_service" value="$(arg calibration_service)" />
  </include>
</launch>
