<?xml version="1.0"?>
<package format="2">
  <name>cuda_depth_registration</name>
  <version>0.1.0</version>
  <description>Side-by-side CUDA depth-to-RGB registration trial for JetHexa.</description>

  <maintainer email="maintainer@example.com">JetHexa Room Mapper maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>astra_camera</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_export_depend>astra_camera</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <exec_depend>astra_camera</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
</package>
